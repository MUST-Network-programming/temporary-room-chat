# 独立任务服务；机密仅放环境变量，不能打包真实 .env。
ASSISTANT_SHARED_SECRET=replace-with-at-least-32-random-characters
CHAT_INTERNAL_WS=ws://127.0.0.1:8081/ws
# 生产账户模式内部 WSS 可指定受信任 CA（同时验证主机名，不可关闭验证）。
CHAT_CA_FILE=
ASSISTANT_STATE=/absolute/private/path/itinerary-state
PUBLIC_BASE_URL=https://43.129.182.26
AI_MODE=rules
# 真实群聊回答及行程提取使用 AI_MODE=openai 和兼容 Chat Completions 的 endpoint/model/key。
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
# 默认只允许本地捕获，绝不向真实成员发送。
ALLOW_EXTERNAL_EMAIL=0
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=itinerary@example.test
SMTP_SSL=0
SMTP_USERNAME=
SMTP_PASSWORD=
# 生产邮件需要自行配置真实 SMTP 并显式设置 ALLOW_EXTERNAL_EMAIL=1。
# 外部 SMTP 默认要求 STARTTLS，465 使用 SMTP_SSL=1。
# 登录验证码、通知邮箱验证码、重要通知和行程提醒共用以上 SMTP 参数。
LOGIN_CODE_TTL=300
LOGIN_RESEND_SECONDS=60
# 与 C 服务 --accounts 指向同一数据库。账号模式的网关必须配置。
ACCOUNTS_DB=/absolute/private/path/accounts.sqlite3
